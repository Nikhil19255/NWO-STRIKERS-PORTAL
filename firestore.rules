rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function admin() {
      return signedIn() && profile().role in ['admin', 'coleader'];
    }
    function leaderFor(teamId) {
      return signedIn()
        && profile().role == 'leader'
        && profile().teamId == teamId;
    }
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || admin());
      allow write: if false;
    }
    match /reports/{id} {
      allow read: if admin() || leaderFor(resource.data.teamId);
      allow create: if admin() || leaderFor(request.resource.data.teamId);
      allow update: if admin()
        || (leaderFor(resource.data.teamId)
            && request.resource.data.teamId == resource.data.teamId);
      allow delete: if admin();
    }
  }
}